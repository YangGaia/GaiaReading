{
  "name": "gaia-reading",
  "version": "0.1.0",
  "description": "电子书阅读器 Demo（Electron + epub.js）",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "test": "node --test tests/*.test.js",
    "copy-vendor": "node scripts/copy-vendor.js",
    "postinstall": "node scripts/copy-vendor.js",
    "smoke:open": "electron . --smoke-test --debug-open tests/fixtures/sample.epub"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "fast-xml-parser": "^4.5.0",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "pdfjs-dist": "3.11.174"
  }
}
